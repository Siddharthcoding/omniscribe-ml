OMNISCRIBE_AUTH_TOKEN=your_shared_secret_token

# Optional: Base64-encoded Netscape-format cookies file for YouTube authentication.
# Helps bypass rate limiting on cloud IPs when using yt-dlp.
# Export cookies from your browser (e.g., "Get cookies.txt" extension), then:
#   certutil -encode cookies.txt cookies.b64 && type cookies.b64
# Strip the BEGIN/END lines and set the base64 content here.
# YOUTUBE_COOKIES=your_base64_encoded_cookies_here
